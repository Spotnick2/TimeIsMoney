package-as: TimeIsMoney
enable-nolib-creation: no
externals:
  # The glass material (Spotnick2/LibGlass, MIT), embedded at the path its MEDIA
  # expects. Pinned to a tag; bumped only in a release made anyway.
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r1
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - .github
  - .agents
  - .claude
  - .codex
  - .playwright-mcp
  - docs
  - tests
  - Tools
  # Developer-only client measurement addon (#9).
  - Probe
  - AGENTS.md
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  - Media/README.md
  # The packager does not apply an external's own ignore list (Priestly #53).
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
